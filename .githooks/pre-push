#!/usr/bin/env sh
set -eu
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_ref" in
    refs/heads/main) ;;
    refs/tags/v[0-9]*.[0-9]*.[0-9]*) ;;
    *) echo "Push interdit pour $local_ref (seuls main et les tags SemVer sont autorisés)." >&2; exit 1 ;;
  esac
done
python scripts/release_check.py